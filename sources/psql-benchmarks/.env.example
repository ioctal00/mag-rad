# Node/runtime identity
BENCH_NODE_ROLE=coordinator
BENCH_REGION=eu
BENCH_RUN_DIR=runs

# 1s is a good baseline default: fine enough for VM-level resource trends,
# but low-overhead enough to keep measurement distortion small.
BENCH_SAMPLE_INTERVAL_SECONDS=1
BENCH_CAPTURE_DURATION_SECONDS=30

# During real thesis runs, increase measurement iterations after the flow is
# stable, for example 30+ iterations per query template.
BENCH_WARMUP_ITERATIONS=1
BENCH_MEASUREMENT_ITERATIONS=5
BENCH_APPLICATION_NAME=psql-benchmarks

# PostgreSQL/libpq connection variables.
# Coordinator-local baseline:
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=app
PGUSER=postgres
PGPASSWORD=change-me
PGSSLMODE=disable
PGSSLROOTCERT=

# Optional labels used in run metadata.
BENCH_CLUSTER_LABEL=eu-citus-single-region
BENCH_DATASET_LABEL=citus-datagen-minimal
BENCH_NOTES=

# Dataset generator parameters are copied into run metadata and
# snapshots/*_dataset_parameters.json. They describe the dataset without
# dumping or sampling user table contents.
DATAGEN_REGION=eu
DATAGEN_TENANT_START=1
DATAGEN_TENANT_END=1000
DATAGEN_RANDOM_SEED=42
DATAGEN_EVENTS_PER_TENANT=100
DATAGEN_USERS_PER_TENANT=50
DATAGEN_ENABLE_GLOBAL_USERS=false
DATAGEN_LOOKBACK_DAYS=30
DATAGEN_LOAD_METHOD=copy_pipe
DATAGEN_DISTRIBUTION=uniform
DATAGEN_HOT_TENANT_PCT=1
DATAGEN_HOT_EVENT_PCT=50
DATAGEN_BASE_TIME_UNIX=0
