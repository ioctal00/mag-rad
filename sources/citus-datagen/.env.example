# PostgreSQL target
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
POSTGRES_ENABLE_ECHO=false
PG_BOUNCER_PORT=6432

# TLS
# Remote on-node execution should use direct PostgreSQL on 5432 for Citus DDL.
# Local WSL -> remote coordinator should usually use verify-ca.
POSTGRES_SSL_MODE=disable
POSTGRES_SSL_ROOT_CERT=

# Minimal datagen scope
DATAGEN_REGION=eu
DATAGEN_TENANT_START=1
DATAGEN_TENANT_END=1000
# Optional disjoint physical ranges with stable logical labels. When set, this
# supersedes DATAGEN_TENANT_START/END for copy_pipe generation.
DATAGEN_TENANT_RANGES=
# tenant_global keeps event identity stable when a tenant moves between regions.
DATAGEN_EVENT_ID_MODE=local_sequential
DATAGEN_OUTPUT_DIR=generated/eu

# Optional future controls
DATAGEN_RANDOM_SEED=42
DATAGEN_EVENTS_PER_TENANT=100
# Number of rows generated in the colocated users table for each tenant.
# events.user_id is generated inside this per-tenant range.
DATAGEN_USERS_PER_TENANT=50
# Optional global_users row count per tenant. Defaults to DATAGEN_USERS_PER_TENANT
# when unset.
DATAGEN_GLOBAL_USERS_PER_TENANT=50
# Optional non-colocated user dimension. When true, the generator also loads
# global_users, distributed by user_id instead of tenant_id.
DATAGEN_ENABLE_GLOBAL_USERS=false
DATAGEN_LOOKBACK_DAYS=30
DATAGEN_LOAD_METHOD=csv
DATAGEN_SQL_BATCH_TENANTS=1000

# copy_pipe controls
DATAGEN_COPY_GENERATOR_PATH=tools/cpp/citus_datagen
DATAGEN_DISTRIBUTION=uniform
DATAGEN_HOT_TENANT_PCT=1
DATAGEN_HOT_EVENT_PCT=50
# Set to a Unix timestamp for stable created_at values across repeated loads.
DATAGEN_BASE_TIME_UNIX=0
