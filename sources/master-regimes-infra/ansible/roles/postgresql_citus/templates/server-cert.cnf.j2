[ req ]
default_bits = {{ postgresql_tls_server_key_size }}
prompt = no
default_md = sha256
distinguished_name = dn
req_extensions = v3_req

[ dn ]
CN = {{ inventory_hostname }}

[ v3_req ]
subjectAltName = @alt_names
extendedKeyUsage = serverAuth
keyUsage = critical, digitalSignature, keyEncipherment

[ alt_names ]
DNS.1 = {{ inventory_hostname }}
DNS.2 = localhost
IP.1 = 127.0.0.1
{% set ns = namespace(ip_index=2, dns_index=3) %}
{% if ansible_host is defined and ansible_host | regex_search('^[0-9.]+$') %}
IP.{{ ns.ip_index }} = {{ ansible_host }}
{% set ns.ip_index = ns.ip_index + 1 %}
{% elif ansible_host is defined %}
DNS.{{ ns.dns_index }} = {{ ansible_host }}
{% set ns.dns_index = ns.dns_index + 1 %}
{% endif %}
{% if private_ip is defined and private_ip %}
IP.{{ ns.ip_index }} = {{ private_ip }}
{% set ns.ip_index = ns.ip_index + 1 %}
{% endif %}
