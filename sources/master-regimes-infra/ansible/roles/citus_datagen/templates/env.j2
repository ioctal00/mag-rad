# PostgreSQL target
POSTGRES_HOST={{ citus_datagen_remote_postgres_host }}
POSTGRES_PORT={{ citus_datagen_remote_postgres_port }}
POSTGRES_USER={{ citus_datagen_remote_postgres_user }}
POSTGRES_PASSWORD={{ citus_datagen_remote_postgres_password }}
POSTGRES_DB={{ citus_datagen_remote_postgres_db }}
POSTGRES_ENABLE_ECHO=false
PG_BOUNCER_PORT={{ pgbouncer_listen_port }}

# TLS
POSTGRES_SSL_MODE={{ citus_datagen_remote_postgres_ssl_mode }}
POSTGRES_SSL_ROOT_CERT={{ citus_datagen_remote_postgres_ssl_root_cert }}

# Minimal datagen scope
DATAGEN_REGION={{ citus_datagen_region_effective }}
DATAGEN_TENANT_START={{ citus_datagen_tenant_ranges[citus_datagen_region_effective].start }}
DATAGEN_TENANT_END={{ citus_datagen_tenant_ranges[citus_datagen_region_effective].end }}
DATAGEN_OUTPUT_DIR={{ citus_datagen_output_root }}/{{ citus_datagen_region_effective }}
DATAGEN_RANDOM_SEED={{ citus_datagen_random_seed }}
DATAGEN_EVENTS_PER_TENANT={{ citus_datagen_events_per_tenant }}
DATAGEN_USERS_PER_TENANT={{ citus_datagen_users_per_tenant }}
DATAGEN_GLOBAL_USERS_PER_TENANT={{ citus_datagen_global_users_per_tenant | default(citus_datagen_users_per_tenant) }}
DATAGEN_ENABLE_GLOBAL_USERS={{ citus_datagen_enable_global_users | default(false) | lower }}
DATAGEN_LOOKBACK_DAYS={{ citus_datagen_lookback_days }}
DATAGEN_PROGRESS_EVERY_TENANTS={{ citus_datagen_progress_every_tenants }}
DATAGEN_LOAD_METHOD={{ citus_datagen_load_method }}
DATAGEN_SQL_BATCH_TENANTS={{ citus_datagen_sql_batch_tenants }}
DATAGEN_COPY_GENERATOR_PATH={{ citus_datagen_copy_generator_path }}
DATAGEN_DISTRIBUTION={{ citus_datagen_distribution }}
DATAGEN_HOT_TENANT_PCT={{ citus_datagen_hot_tenant_pct }}
DATAGEN_HOT_EVENT_PCT={{ citus_datagen_hot_event_pct }}
DATAGEN_BASE_TIME_UNIX={{ citus_datagen_base_time_unix }}
