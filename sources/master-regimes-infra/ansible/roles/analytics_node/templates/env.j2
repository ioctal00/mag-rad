ANALYTICS_CLIENT_REGION={{ analytics_node_region_effective }}
ANALYTICS_CLIENT_RUN_ROOT={{ analytics_node_run_root }}
ANALYTICS_CLIENT_LOG_DIR={{ analytics_node_log_dir }}
ANALYTICS_CLIENT_NOTES={{ analytics_node_notes }}

ANALYTICS_POSTGRES_ENABLED={{ 'true' if analytics_node_postgresql_enabled else 'false' }}
ANALYTICS_POSTGRES_HOST=127.0.0.1
ANALYTICS_POSTGRES_PORT=5432
ANALYTICS_POSTGRES_DB={{ analytics_node_postgresql_app_db }}
ANALYTICS_POSTGRES_USER={{ analytics_node_postgresql_experiment_user | default('postgres') }}
ANALYTICS_POSTGRES_PASSWORD={{ analytics_node_postgresql_experiment_password | default(analytics_node_postgresql_admin_password) }}

ANALYTICS_TLS_CA_FILE={{ analytics_node_tls_dir }}/{{ analytics_node_tls_ca_filename }}

{% for region_name, remote in analytics_node_remote_regions.items() %}
REGION_{{ region_name | upper }}_POSTGRES_HOST={{ remote.host }}
REGION_{{ region_name | upper }}_POSTGRES_PORT={{ remote.port }}
REGION_{{ region_name | upper }}_POSTGRES_DB={{ remote.db }}
REGION_{{ region_name | upper }}_POSTGRES_USER={{ remote.user }}
REGION_{{ region_name | upper }}_POSTGRES_PASSWORD={{ remote.password }}
REGION_{{ region_name | upper }}_POSTGRES_SSLMODE={{ remote.sslmode }}
REGION_{{ region_name | upper }}_POSTGRES_SSLROOTCERT={{ analytics_node_tls_dir }}/{{ analytics_node_tls_ca_filename }}
{% endfor %}
