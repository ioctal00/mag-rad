# Benchmark identity
BENCH_NODE_ROLE={{ psql_benchmarks_node_role_effective }}
BENCH_REGION={{ psql_benchmarks_region_effective }}
BENCH_RUN_DIR={{ psql_benchmarks_run_dir }}
BENCH_SAMPLE_INTERVAL_SECONDS={{ psql_benchmarks_sample_interval_seconds }}
BENCH_CAPTURE_DURATION_SECONDS={{ psql_benchmarks_capture_duration_seconds }}
BENCH_WARMUP_ITERATIONS={{ psql_benchmarks_warmup_iterations }}
BENCH_MEASUREMENT_ITERATIONS={{ psql_benchmarks_measurement_iterations }}
BENCH_APPLICATION_NAME={{ psql_benchmarks_application_name }}

# PostgreSQL/libpq target
{% if 'analytics_clients' in group_names %}
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE={{ analytics_node_postgresql_app_db }}
PGUSER={{ analytics_node_postgresql_experiment_user | default('postgres') }}
PGPASSWORD={{ analytics_node_postgresql_experiment_password | default(analytics_node_postgresql_admin_password) }}
PGSSLMODE=disable
PGSSLROOTCERT=
{% else %}
PGHOST={{ psql_benchmarks_remote_postgres_host }}
PGPORT={{ psql_benchmarks_remote_postgres_port }}
PGDATABASE={{ psql_benchmarks_remote_postgres_db }}
PGUSER={{ psql_benchmarks_remote_postgres_user }}
PGPASSWORD={{ psql_benchmarks_remote_postgres_password }}
PGSSLMODE={{ psql_benchmarks_remote_postgres_ssl_mode }}
PGSSLROOTCERT={{ psql_benchmarks_remote_postgres_ssl_root_cert }}
{% endif %}

{% if 'analytics_clients' in group_names %}
# Regional PostgreSQL sources for postgres_fdw bootstrap.
ANALYTICS_TLS_CA_FILE={{ analytics_node_tls_dir }}/{{ analytics_node_tls_ca_filename }}
BENCH_FDW_REMOTE_PLAN_DEFAULT_REGION={{ global_analytics_anchor_region | default('') }}
{% for region_name, remote in analytics_node_remote_regions.items() %}
REGION_{{ region_name | upper }}_POSTGRES_HOST={{ remote.host }}
REGION_{{ region_name | upper }}_POSTGRES_PORT={{ remote.port }}
REGION_{{ region_name | upper }}_POSTGRES_DB={{ remote.db }}
REGION_{{ region_name | upper }}_POSTGRES_USER={{ remote.user }}
REGION_{{ region_name | upper }}_POSTGRES_PASSWORD={{ remote.password }}
REGION_{{ region_name | upper }}_POSTGRES_SSLMODE={{ remote.sslmode }}
REGION_{{ region_name | upper }}_POSTGRES_SSLROOTCERT={{ analytics_node_tls_dir }}/{{ analytics_node_tls_ca_filename }}
{% if web_portal_enabled | default(false) and web_portal_db_readonly_user | default('') | length > 0 and web_portal_db_readonly_password | default('') | length > 0 %}
REGION_{{ region_name | upper }}_POSTGRES_READONLY_USER={{ web_portal_db_readonly_user }}
REGION_{{ region_name | upper }}_POSTGRES_READONLY_PASSWORD={{ web_portal_db_readonly_password }}
{% endif %}
{% endfor %}
{% endif %}

# Run labels
BENCH_CLUSTER_LABEL={{ psql_benchmarks_cluster_label }}
BENCH_DATASET_LABEL={{ psql_benchmarks_dataset_label }}
BENCH_NOTES={{ psql_benchmarks_notes }}

# Dataset generator parameters. These are metadata only; benchmark snapshots
# must not dump or sample user table contents.
DATAGEN_REGION={{ psql_benchmarks_region_effective }}
DATAGEN_TENANT_START={{ (citus_datagen_tenant_ranges | default({})).get(psql_benchmarks_region_effective, {}).get('start', '') }}
DATAGEN_TENANT_END={{ (citus_datagen_tenant_ranges | default({})).get(psql_benchmarks_region_effective, {}).get('end', '') }}
DATAGEN_RANDOM_SEED={{ citus_datagen_random_seed | default('') }}
DATAGEN_EVENTS_PER_TENANT={{ citus_datagen_events_per_tenant | default('') }}
DATAGEN_USERS_PER_TENANT={{ citus_datagen_users_per_tenant | default('') }}
DATAGEN_GLOBAL_USERS_PER_TENANT={{ citus_datagen_global_users_per_tenant | default(citus_datagen_users_per_tenant | default('')) }}
DATAGEN_ENABLE_GLOBAL_USERS={{ citus_datagen_enable_global_users | default(false) | lower }}
DATAGEN_LOOKBACK_DAYS={{ citus_datagen_lookback_days | default('') }}
DATAGEN_LOAD_METHOD={{ citus_datagen_load_method | default('') }}
DATAGEN_DISTRIBUTION={{ citus_datagen_distribution | default('') }}
DATAGEN_HOT_TENANT_PCT={{ citus_datagen_hot_tenant_pct | default('') }}
DATAGEN_HOT_EVENT_PCT={{ citus_datagen_hot_event_pct | default('') }}
DATAGEN_BASE_TIME_UNIX={{ citus_datagen_base_time_unix | default('') }}
