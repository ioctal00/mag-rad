  backend_plan              = var.backend_plan
  web_portal_enabled        = var.web_portal_enabled
  web_portal_plan           = var.web_portal_plan
  bare_metal_mdisk_mode     = var.bare_metal_mdisk_mode
  coordinator_plan          = var.coordinator_plan
  worker_plan               = var.worker_plan
  os_id                     = var.os_id
  enable_ipv6               = var.enable_ipv6
  app_port                  = var.app_port
