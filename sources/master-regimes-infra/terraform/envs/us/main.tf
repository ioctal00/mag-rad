module "region" {
  source = "../../modules/region"

  project_tag               = var.project_tag
  environment               = "us"
  region_code               = var.region_code
  existing_vpc_id           = var.existing_vpc_id
  existing_vpc_cidr         = var.existing_vpc_cidr
