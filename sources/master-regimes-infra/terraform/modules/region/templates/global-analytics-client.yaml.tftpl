#cloud-config
package_update: true
package_upgrade: true
packages:
  - python3
  - python3-apt
  - python3-pip
  - python3-venv
  - curl
  - ca-certificates
  - gnupg
  - git
  - jq
  - postgresql-client
  - rsync
  - sudo
  - acl
write_files:
  - path: /etc/motd
    permissions: "0644"
    owner: root:root
    content: |
      Thesis infrastructure node: global analytics client
      Intended for ETL and manually decomposed live-federation experiments.
      Provisioned by Terraform. Configure experiment tooling separately.
runcmd:
  - [systemctl, daemon-reload]
