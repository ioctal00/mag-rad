#cloud-config
package_update: true
package_upgrade: true
packages:
  - python3
  - python3-apt
  - curl
  - ca-certificates
  - jq
  - sudo
  - acl
  - rsync
write_files:
  - path: /etc/motd
    permissions: "0644"
    owner: root:root
    content: |
      Thesis infrastructure node: cloudb-web portal
      Intended for Pgweb and Regime Diagnosis Viewer access.
      Provisioned by Terraform. Configure services with Ansible.
runcmd:
  - [systemctl, daemon-reload]
