select
  gu.user_segment,
  gu.user_status,
  count(*) as events_count,
  round(sum(e.value::numeric), 6) as total_value
from events e
join global_users gu
  on gu.tenant_id = e.tenant_id
 and gu.user_id = e.user_id
where e.created_at >= timestamptz '{{ cutoff_ts }}'
  and ({{ tenant_id_filter | default(0) }}::bigint = 0 or e.tenant_id = {{ tenant_id_filter | default(0) }}::bigint)
  and mod(e.tenant_id, {{ tenant_modulus | default(1) }}::bigint) = 0
  and e.user_id <= {{ user_id_max | default(2147483647) }}::bigint
group by gu.user_segment, gu.user_status
order by total_value desc, gu.user_segment, gu.user_status
limit {{ limit_k }};
