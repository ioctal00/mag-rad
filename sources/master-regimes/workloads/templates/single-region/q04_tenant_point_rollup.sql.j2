select
  tenant_id,
  count(*) as events_count,
  sum(value) as total_value,
  avg(value) as avg_value,
  max(created_at) as last_event_at
from events
where tenant_id = {{ tenant_id }}::bigint
  and created_at >= coalesce(to_timestamp(nullif({{ as_of_unix | default(0) }}, 0)), now()) - make_interval(days => {{ lookback_days }}::int)
group by tenant_id;
