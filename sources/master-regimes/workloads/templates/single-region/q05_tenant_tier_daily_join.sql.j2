select
  t.tenant_tier,
  date_trunc('day', e.created_at) as event_day,
  count(*) as events_count,
  count(distinct e.tenant_id) as tenant_count,
  round(sum(e.value::numeric), 6) as total_value,
  round(avg(e.value::numeric), 6) as avg_value
from events e
join tenants t
  on t.tenant_id = e.tenant_id
where e.created_at >= coalesce(to_timestamp(nullif({{ as_of_unix | default(0) }}, 0)), now()) - make_interval(days => {{ lookback_days }}::int)
group by t.tenant_tier, date_trunc('day', e.created_at)
order by event_day, total_value desc, t.tenant_tier;
