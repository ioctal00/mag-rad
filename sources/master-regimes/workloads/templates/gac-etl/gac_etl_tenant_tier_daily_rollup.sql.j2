select
  tenant_tier,
  event_day,
  sum(events_count) as events_count,
  sum(tenant_count) as tenant_count,
  sum(total_value) as total_value,
  sum(total_value) / nullif(sum(events_count), 0) as avg_value
from etl.daily_tenant_tier_rollup
where event_day >= current_date - {{ lookback_days }}::int
group by tenant_tier, event_day
order by event_day, total_value desc, tenant_tier;
