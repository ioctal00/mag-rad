with regional_tenant as (
  select
    'eu'::text as source_region,
    e.tenant_id,
    count(*) as events_count,
    sum(e.value) as total_value,
    avg(e.value) as avg_value
  from fdw_eu.events e
  where e.tenant_id = {{ eu_tenant_id }}::bigint
    and e.created_at >= coalesce(to_timestamp(nullif({{ as_of_unix | default(0) }}, 0)), now()) - make_interval(days => {{ lookback_days }}::int)
  group by e.tenant_id
  union all
  select
    'us'::text as source_region,
    e.tenant_id,
    count(*) as events_count,
    sum(e.value) as total_value,
    avg(e.value) as avg_value
  from fdw_us.events e
  where e.tenant_id = {{ us_tenant_id }}::bigint
    and e.created_at >= coalesce(to_timestamp(nullif({{ as_of_unix | default(0) }}, 0)), now()) - make_interval(days => {{ lookback_days }}::int)
  group by e.tenant_id
)
select
  source_region,
  tenant_id,
  events_count,
  total_value,
  avg_value
from regional_tenant
order by source_region, tenant_id;
