select
  e.event_id,
  e.tenant_id,
  e.user_id,
  e.value,
  e.created_at,
  repeat(
    md5(e.event_id::text || ':' || e.tenant_id::text || ':' || e.user_id::text),
    {{ payload_repeat }}::int
  )::varchar({{ payload_width }}) as synthetic_payload
from fdw_eu.events e
where e.created_at >= now() - make_interval(days => {{ lookback_days }}::int)
  and e.value >= {{ min_value }}::double precision
order by e.created_at desc, e.tenant_id, e.event_id
limit {{ limit_k }};
