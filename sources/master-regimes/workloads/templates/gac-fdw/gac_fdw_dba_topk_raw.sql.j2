with events_all as materialized (
  select 'eu'::text as source_region, e.event_id, e.tenant_id, e.user_id,
         e.value, e.created_at
  from fdw_eu.events e
  where e.created_at >= timestamptz '{{ cutoff_ts }}'
  union all
  select 'us'::text as source_region, e.event_id, e.tenant_id, e.user_id,
         e.value, e.created_at
  from fdw_us.events e
  where e.created_at >= timestamptz '{{ cutoff_ts }}'
{% if include_apac %}
  union all
  select 'apac'::text as source_region, e.event_id, e.tenant_id, e.user_id,
         e.value, e.created_at
  from fdw_apac.events e
  where e.created_at >= timestamptz '{{ cutoff_ts }}'
{% endif %}
)
{% if query_shape == 'event_value_desc' %}
select source_region, tenant_id as key_1, user_id as key_2,
       null::timestamptz as bucket_at, value::double precision as metric,
       event_id, created_at
from events_all
order by metric desc, source_region, key_1, key_2, event_id
{% elif query_shape == 'event_value_asc' %}
select source_region, tenant_id as key_1, user_id as key_2,
       null::timestamptz as bucket_at, value::double precision as metric,
       event_id, created_at
from events_all
order by metric asc, source_region, key_1, key_2, event_id
{% elif query_shape == 'event_recent' %}
select source_region, tenant_id as key_1, user_id as key_2,
       null::timestamptz as bucket_at,
       extract(epoch from created_at)::double precision as metric,
       event_id, created_at
from events_all
order by metric desc, source_region, key_1, key_2, event_id
{% elif query_shape == 'event_oldest' %}
select source_region, tenant_id as key_1, user_id as key_2,
       null::timestamptz as bucket_at,
       extract(epoch from created_at)::double precision as metric,
       event_id, created_at
from events_all
order by metric asc, source_region, key_1, key_2, event_id
{% elif query_shape == 'event_deviation' %}
select source_region, tenant_id as key_1, user_id as key_2,
       null::timestamptz as bucket_at,
       abs(value - 500.0)::double precision as metric, event_id, created_at
from events_all
order by metric desc, source_region, key_1, key_2, event_id
{% elif query_shape == 'event_value_squared' %}
select source_region, tenant_id as key_1, user_id as key_2,
       null::timestamptz as bucket_at,
       round((value::double precision * value::double precision)::numeric, 6)::double precision
         as metric,
       event_id, created_at
from events_all
order by metric desc, source_region, key_1, key_2, event_id
{% elif query_shape == 'event_log_value' %}
select source_region, tenant_id as key_1, user_id as key_2,
       null::timestamptz as bucket_at,
       round(ln(1.0 + abs(value::double precision))::numeric, 6)::double precision
         as metric, event_id, created_at
from events_all
order by metric desc, source_region, key_1, key_2, event_id
{% elif query_shape == 'event_recent_high_value' %}
select source_region, tenant_id as key_1, user_id as key_2,
       null::timestamptz as bucket_at,
       extract(epoch from created_at)::double precision as metric,
       event_id, created_at
from events_all
where value >= 750.0
order by metric desc, source_region, key_1, key_2, event_id
{% elif query_shape == 'event_old_low_value' %}
select source_region, tenant_id as key_1, user_id as key_2,
       null::timestamptz as bucket_at,
       extract(epoch from created_at)::double precision as metric,
       event_id, created_at
from events_all
where value <= 250.0
order by metric asc, source_region, key_1, key_2, event_id
{% elif query_shape == 'event_tenant_weighted' %}
select source_region, tenant_id as key_1, user_id as key_2,
       null::timestamptz as bucket_at,
       round(
         (value::double precision / (1 + (tenant_id % 17))::double precision)::numeric,
         6
       )::double precision as metric,
       event_id, created_at
from events_all
order by metric desc, source_region, key_1, key_2, event_id
{% elif query_shape == 'tenant_sum' %}
select source_region, tenant_id as key_1, null::bigint as key_2,
       null::timestamptz as bucket_at, sum(value)::double precision as metric,
       null::bigint as event_id, null::timestamptz as created_at
from events_all
group by source_region, tenant_id
order by metric desc, source_region, key_1
{% elif query_shape == 'tenant_count' %}
select source_region, tenant_id as key_1, null::bigint as key_2,
       null::timestamptz as bucket_at, count(*)::double precision as metric,
       null::bigint as event_id, null::timestamptz as created_at
from events_all
group by source_region, tenant_id
order by metric desc, source_region, key_1
{% elif query_shape == 'tenant_avg' %}
select source_region, tenant_id as key_1, null::bigint as key_2,
       null::timestamptz as bucket_at, avg(value)::double precision as metric,
       null::bigint as event_id, null::timestamptz as created_at
from events_all
group by source_region, tenant_id
order by metric desc, source_region, key_1
{% elif query_shape == 'tenant_max' %}
select source_region, tenant_id as key_1, null::bigint as key_2,
       null::timestamptz as bucket_at, max(value)::double precision as metric,
       null::bigint as event_id, null::timestamptz as created_at
from events_all
group by source_region, tenant_id
order by metric desc, source_region, key_1
{% elif query_shape == 'tenant_min' %}
select source_region, tenant_id as key_1, null::bigint as key_2,
       null::timestamptz as bucket_at, min(value)::double precision as metric,
       null::bigint as event_id, null::timestamptz as created_at
from events_all
group by source_region, tenant_id
order by metric asc, source_region, key_1
{% elif query_shape == 'tenant_high_count' %}
select source_region, tenant_id as key_1, null::bigint as key_2,
       null::timestamptz as bucket_at, count(*)::double precision as metric,
       null::bigint as event_id, null::timestamptz as created_at
from events_all
where value >= 750.0
group by source_region, tenant_id
order by metric desc, source_region, key_1
{% elif query_shape == 'tenant_user_sum' %}
select source_region, tenant_id as key_1, user_id as key_2,
       null::timestamptz as bucket_at, sum(value)::double precision as metric,
       null::bigint as event_id, null::timestamptz as created_at
from events_all
group by source_region, tenant_id, user_id
order by metric desc, source_region, key_1, key_2
{% elif query_shape == 'tenant_user_count' %}
select source_region, tenant_id as key_1, user_id as key_2,
       null::timestamptz as bucket_at, count(*)::double precision as metric,
       null::bigint as event_id, null::timestamptz as created_at
from events_all
group by source_region, tenant_id, user_id
order by metric desc, source_region, key_1, key_2
{% elif query_shape == 'tenant_day_sum' %}
select source_region, tenant_id as key_1, null::bigint as key_2,
       date_trunc('day', created_at) as bucket_at,
       sum(value)::double precision as metric, null::bigint as event_id,
       null::timestamptz as created_at
from events_all
group by source_region, tenant_id, date_trunc('day', created_at)
order by metric desc, source_region, key_1, bucket_at
{% elif query_shape == 'tenant_day_count' %}
select source_region, tenant_id as key_1, null::bigint as key_2,
       date_trunc('day', created_at) as bucket_at,
       count(*)::double precision as metric, null::bigint as event_id,
       null::timestamptz as created_at
from events_all
group by source_region, tenant_id, date_trunc('day', created_at)
order by metric desc, source_region, key_1, bucket_at
{% elif query_shape == 'tenant_value_range' %}
select source_region, tenant_id as key_1, null::bigint as key_2,
       null::timestamptz as bucket_at,
       round((max(value) - min(value))::numeric, 6)::double precision as metric,
       null::bigint as event_id, null::timestamptz as created_at
from events_all
group by source_region, tenant_id
order by metric desc, source_region, key_1
{% elif query_shape == 'tenant_distinct_users' %}
select source_region, tenant_id as key_1, null::bigint as key_2,
       null::timestamptz as bucket_at,
       count(distinct user_id)::double precision as metric,
       null::bigint as event_id, null::timestamptz as created_at
from events_all
group by source_region, tenant_id
order by metric desc, source_region, key_1
{% elif query_shape == 'tenant_even_user_count' %}
select source_region, tenant_id as key_1, null::bigint as key_2,
       null::timestamptz as bucket_at, count(*)::double precision as metric,
       null::bigint as event_id, null::timestamptz as created_at
from events_all
where user_id % 2 = 0
group by source_region, tenant_id
order by metric desc, source_region, key_1
{% elif query_shape == 'tenant_midband_sum' %}
select source_region, tenant_id as key_1, null::bigint as key_2,
       null::timestamptz as bucket_at,
       round(sum(value)::numeric, 6)::double precision as metric,
       null::bigint as event_id, null::timestamptz as created_at
from events_all
where value between 250.0 and 750.0
group by source_region, tenant_id
order by metric desc, source_region, key_1
{% elif query_shape == 'tenant_day_avg' %}
select source_region, tenant_id as key_1, null::bigint as key_2,
       date_trunc('day', created_at) as bucket_at,
       round(avg(value)::numeric, 6)::double precision as metric, null::bigint as event_id,
       null::timestamptz as created_at
from events_all
group by source_region, tenant_id, date_trunc('day', created_at)
order by metric desc, source_region, key_1, bucket_at
{% elif query_shape == 'tenant_hour_count' %}
select source_region, tenant_id as key_1, null::bigint as key_2,
       date_trunc('hour', created_at) as bucket_at,
       count(*)::double precision as metric, null::bigint as event_id,
       null::timestamptz as created_at
from events_all
group by source_region, tenant_id, date_trunc('hour', created_at)
order by metric desc, source_region, key_1, bucket_at
{% elif query_shape == 'user_sum' %}
select source_region, user_id as key_1, null::bigint as key_2,
       null::timestamptz as bucket_at,
       round(sum(value)::numeric, 6)::double precision as metric,
       null::bigint as event_id, null::timestamptz as created_at
from events_all
group by source_region, user_id
order by metric desc, source_region, key_1
{% elif query_shape == 'user_count' %}
select source_region, user_id as key_1, null::bigint as key_2,
       null::timestamptz as bucket_at, count(*)::double precision as metric,
       null::bigint as event_id, null::timestamptz as created_at
from events_all
group by source_region, user_id
order by metric desc, source_region, key_1
{% elif query_shape == 'user_value_range' %}
select source_region, user_id as key_1, null::bigint as key_2,
       null::timestamptz as bucket_at,
       round((max(value) - min(value))::numeric, 6)::double precision as metric,
       null::bigint as event_id, null::timestamptz as created_at
from events_all
group by source_region, user_id
order by metric desc, source_region, key_1
{% elif query_shape == 'user_day_sum' %}
select source_region, user_id as key_1, null::bigint as key_2,
       date_trunc('day', created_at) as bucket_at,
       round(sum(value)::numeric, 6)::double precision as metric, null::bigint as event_id,
       null::timestamptz as created_at
from events_all
group by source_region, user_id, date_trunc('day', created_at)
order by metric desc, source_region, key_1, bucket_at
{% else %}
select 1 / 0 as unsupported_query_shape
{% endif %}
limit {{ limit_k }};
