with regional_events as materialized (
  select
    'eu'::text as source_region,
    e.tenant_id,
    e.value,
    e.created_at
  from fdw_eu.events e
  where e.created_at >= coalesce(to_timestamp(nullif({{ as_of_unix | default(0) }}, 0)), now()) - make_interval(days => {{ lookback_days }}::int)
  union all
  select
    'us'::text as source_region,
    e.tenant_id,
    e.value,
    e.created_at
  from fdw_us.events e
  where e.created_at >= coalesce(to_timestamp(nullif({{ as_of_unix | default(0) }}, 0)), now()) - make_interval(days => {{ lookback_days }}::int)
),
regional_tenants as (
  select
    source_region,
    tenant_id,
    count(*) as events_count,
    sum(value) as total_value,
    max(created_at) as last_event_at
  from regional_events
  group by source_region, tenant_id
)
select
  tenant_id,
  count(distinct source_region) as regions_touched,
  sum(events_count) as events_count,
  sum(total_value) as total_value,
  max(last_event_at) as last_event_at
from regional_tenants
group by tenant_id
order by total_value desc, tenant_id
limit {{ limit_k }};
