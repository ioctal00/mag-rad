select count(*) as result_count
FROM {{ schema_name }}.tags AS t,
  {{ schema_name }}.posts AS p,
  {{ schema_name }}.users AS u,
  {{ schema_name }}.votes AS v,
  {{ schema_name }}.badges AS b
WHERE p.Id = t.ExcerptPostId
  AND u.Id = v.UserId
  AND u.Id = b.UserId
  AND u.Id = p.OwnerUserId
  AND u.Views >= 0
  AND u.Views <= 515
  AND u.UpVotes >= 0
  AND u.CreationDate <= CAST('2014-09-07 13:46:41' AS timestamp)
  AND v.BountyAmount >= 0
  AND v.BountyAmount <= 200
  AND b.Date <= CAST('2014-09-12 12:56:22' AS timestamp)
