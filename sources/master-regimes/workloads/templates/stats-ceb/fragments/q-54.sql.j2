select count(*) as result_count
FROM {{ schema_name }}.comments AS c,
  {{ schema_name }}.postLinks AS pl,
  {{ schema_name }}.posts AS p,
  {{ schema_name }}.users AS u,
  {{ schema_name }}.badges AS b
WHERE p.Id = pl.RelatedPostId
  AND p.Id = c.PostId
  AND u.Id = b.UserId
  AND u.Id = p.OwnerUserId
  AND pl.LinkTypeId = 1
  AND pl.CreationDate >= CAST('2011-04-12 15:23:59' AS timestamp)
  AND p.Score = 1
  AND p.ViewCount >= 0
  AND p.FavoriteCount >= 0
  AND u.CreationDate >= CAST('2011-02-08 18:11:37' AS timestamp)
