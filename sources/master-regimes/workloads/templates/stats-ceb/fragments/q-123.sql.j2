select count(*) as result_count
FROM {{ schema_name }}.postHistory AS ph,
  {{ schema_name }}.posts AS p,
  {{ schema_name }}.users AS u,
  {{ schema_name }}.badges AS b
WHERE b.UserId = u.Id
  AND p.OwnerUserId = u.Id
  AND ph.UserId = u.Id
  AND p.AnswerCount >= 0
  AND p.FavoriteCount >= 0
  AND p.CreationDate <= CAST('2014-09-03 03:32:35' AS timestamp)
  AND u.CreationDate <= CAST('2014-09-12 22:21:49' AS timestamp)
