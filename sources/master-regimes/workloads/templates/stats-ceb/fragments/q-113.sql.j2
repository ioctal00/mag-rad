select count(*) as result_count
FROM {{ schema_name }}.comments AS c,
  {{ schema_name }}.postHistory AS ph,
  {{ schema_name }}.badges AS b,
  {{ schema_name }}.users AS u
WHERE u.Id = b.UserId
  AND u.Id = ph.UserId
  AND u.Id = c.UserId
  AND c.CreationDate <= CAST('2014-09-10 00:33:30' AS timestamp)
  AND u.DownVotes <= 0
  AND u.UpVotes <= 47
