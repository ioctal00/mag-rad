select count(*) as result_count
FROM {{ schema_name }}.comments AS c,
  {{ schema_name }}.postLinks AS pl,
  {{ schema_name }}.postHistory AS ph,
  {{ schema_name }}.votes AS v,
  {{ schema_name }}.posts AS p
WHERE pl.PostId = p.Id
  AND c.PostId = p.Id
  AND v.PostId = p.Id
  AND ph.PostId = p.Id
  AND c.Score = 0
  AND pl.CreationDate >= CAST('2011-03-22 06:18:34' AS timestamp)
  AND pl.CreationDate <= CAST('2014-08-22 20:04:25' AS timestamp)
