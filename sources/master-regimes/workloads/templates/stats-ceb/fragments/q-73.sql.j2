select count(*) as result_count
FROM {{ schema_name }}.comments AS c,
  {{ schema_name }}.posts AS p,
  {{ schema_name }}.postLinks AS pl,
  {{ schema_name }}.postHistory AS ph,
  {{ schema_name }}.votes AS v,
  {{ schema_name }}.badges AS b
WHERE p.Id = c.PostId
  AND p.Id = pl.RelatedPostId
  AND p.Id = ph.PostId
  AND p.Id = v.PostId
  AND b.UserId = c.UserId
  AND c.CreationDate >= CAST('2010-07-22 01:19:43' AS timestamp)
  AND p.Score >= -1
  AND p.ViewCount >= 0
  AND p.CommentCount <= 9
  AND ph.CreationDate >= CAST('2010-09-20 17:45:15' AS timestamp)
  AND ph.CreationDate <= CAST('2014-08-07 01:00:45' AS timestamp)
  AND v.VoteTypeId = 15
