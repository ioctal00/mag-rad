select count(*) as result_count
FROM {{ schema_name }}.comments AS c,
  {{ schema_name }}.votes AS v,
  {{ schema_name }}.badges AS b,
  {{ schema_name }}.users AS u
WHERE u.Id = b.UserId
  AND u.Id = c.UserId
  AND u.Id = v.UserId
  AND c.Score = 1
  AND c.CreationDate >= CAST('2010-07-20 23:17:28' AS timestamp)
  AND u.CreationDate >= CAST('2010-07-20 01:27:29' AS timestamp)
