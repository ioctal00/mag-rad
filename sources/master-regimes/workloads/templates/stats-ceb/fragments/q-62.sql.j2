select count(*) as result_count
FROM {{ schema_name }}.comments AS c,
  {{ schema_name }}.posts AS p,
  {{ schema_name }}.postLinks AS pl,
  {{ schema_name }}.votes AS v,
  {{ schema_name }}.badges AS b,
  {{ schema_name }}.users AS u
WHERE p.Id = c.PostId
  AND p.Id = pl.RelatedPostId
  AND p.Id = v.PostId
  AND u.Id = p.OwnerUserId
  AND u.Id = b.UserId
  AND c.Score = 2
  AND p.ViewCount <= 7710
  AND p.CommentCount <= 12
  AND p.FavoriteCount >= 0
  AND p.FavoriteCount <= 4
  AND p.CreationDate >= CAST('2010-07-27 03:58:22' AS timestamp)
  AND u.UpVotes >= 0
