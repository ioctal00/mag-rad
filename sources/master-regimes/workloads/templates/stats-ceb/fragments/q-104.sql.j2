select count(*) as result_count
FROM {{ schema_name }}.comments AS c,
  {{ schema_name }}.postHistory AS ph,
  {{ schema_name }}.votes AS v,
  {{ schema_name }}.users AS u
WHERE v.UserId = u.Id
  AND c.UserId = u.Id
  AND ph.UserId = u.Id
  AND ph.CreationDate >= CAST('2010-07-28 09:11:34' AS timestamp)
  AND ph.CreationDate <= CAST('2014-09-06 06:51:53' AS timestamp)
  AND u.DownVotes <= 0
  AND u.UpVotes >= 0
  AND u.UpVotes <= 72
