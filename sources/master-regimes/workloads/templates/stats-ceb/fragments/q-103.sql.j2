select count(*) as result_count
FROM {{ schema_name }}.votes AS v,
  {{ schema_name }}.posts AS p,
  {{ schema_name }}.badges AS b,
  {{ schema_name }}.users AS u
WHERE u.Id = b.UserId
  AND u.Id = p.OwnerUserId
  AND u.Id = v.UserId
  AND p.PostTypeId = 1
  AND p.CommentCount >= 0
  AND p.CommentCount <= 15
  AND u.Reputation >= 1
  AND u.DownVotes >= 0
  AND u.DownVotes <= 1
