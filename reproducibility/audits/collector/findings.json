      ],
      "id": "COL-007",
      "impact": "Expected-region checks may reveal a missing required plan, but malformed extra/internal documents disappear without a parse-failure row or source offset.",
      "recommendation": "Emit a parse-error record with host, log path, line range, and document hash.",
